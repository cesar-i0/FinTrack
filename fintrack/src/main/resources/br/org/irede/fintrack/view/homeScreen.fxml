                           <padding>
                              <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                           </padding>
                        </VBox>
                        <VBox prefHeight="200.0" prefWidth="150.0" styleClass="card">
                           <children>
                              <ImageView fitHeight="80.0" fitWidth="80.0" pickOnBounds="true" preserveRatio="true">
                                 <image>
                                    <Image url="@../images/wallet-minus.png" />
                                 </image>
                              </ImageView>
                              <Label styleClass="card-title" text="Saídas Mensais" />
                              <Label fx:id="lblSaidas" styleClass="card-value" text="R$ 0,00" wrapText="true" />
