                     </padding>
                  </Button>
               </children>
            </VBox>
         </children>
      </VBox>
   </left>
   <center>
      <ScrollPane fitToHeight="true" fitToWidth="true" prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER">
         <content>
            <VBox prefHeight="200.0" prefWidth="100.0" spacing="20.0" styleClass="root">
               <padding>
                  <Insets top="20.0" />
               </padding>
               <children>
                  <Label styleClass="title-header" text="Bem-vindo de volta, Cliente!">
                     <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                     </padding>
                  </Label>
                  <HBox prefHeight="100.0" prefWidth="200.0" spacing="20.0">
                     <children>
                        <VBox prefHeight="200.0" prefWidth="150.0" styleClass="card">
                           <children>
                              <ImageView fitHeight="80.0" fitWidth="80.0" pickOnBounds="true" preserveRatio="true">
                                 <image>
                                    <Image url="@../images/wallet.png" />
                                 </image>
                              </ImageView>
                              <Label styleClass="card-title" text="Saldo" />
                              <Label fx:id="lblSaldo" styleClass="card-value" text="R$ 0,00" wrapText="true" />
                           </children>
                           <padding>
                              <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                           </padding>
                        </VBox>
                        <VBox prefHeight="200.0" prefWidth="150.0" styleClass="card">
                           <children>
                              <ImageView fitHeight="80.0" fitWidth="80.0" pickOnBounds="true" preserveRatio="true">
                                 <image>
                                    <Image url="@../images/wallet-add.png" />
                                 </image>
                              </ImageView>
                              <Label styleClass="card-title" text="Entradas Mensais" />
                              <Label fx:id="lblEntradas" styleClass="card-value" text="R$ 0,00" wrapText="true" />
